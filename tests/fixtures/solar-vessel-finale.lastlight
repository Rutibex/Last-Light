00,58701,58702,58703,58704,58705,58812,58813,58814,58815,58816,58817,58818,58819,58820,58821,58822,58823,58824,58825,58826,58827,58828,58829,58830,58831,58832,58833,58940,58941,58942,58943,58944,58945,58946,58947,58948,58949,58950,58951,58952,58953,58954,58955,58956,58957,58958,58959,58960,58961,59068,59069,59070,59071,59072,59073,59074,59075,59076,59077,59078,59079,59080,59081,59082,59083,59084,59085,59086,59087,59088,59089],\u0022bridgeFloors\u0022:[24004,24003,24002],\u0022unstableSince\u0022:{},\u0022debris\u0022:[],\u0022buried\u0022:[],\u0022formulae\u0022:{\u002225\u0022:{\u0022entityId\u0022:25,\u0022skill\u0022:10,\u0022strain\u0022:0,\u0022known\u0022:[\u0022ember\u0022,\u0022door\u0022,\u0022flesh\u0022,\u0022porter\u0022],\u0022queue\u0022:[],\u0022prepared\u0022:[{\u0022id\u0022:14,\u0022formulaId\u0022:\u0022door\u0022,\u0022preparedAt\u0022:35940},{\u0022id\u0022:16,\u0022formulaId\u0022:\u0022flesh\u0022,\u0022preparedAt\u0022:39510},{\u0022id\u0022:18,\u0022formulaId\u0022:\u0022porter\u0022,\u0022preparedAt\u0022:52500}],\u0022capacity\u0022:6},\u002226\u0022:{\u0022entityId\u0022:26,\u0022skill\u0022:5,\u0022strain\u0022:0,\u0022known\u0022:[],\u0022queue\u0022:[],\u0022prepared\u0022:[],\u0022capacity\u0022:5},\u002227\u0022:{\u0022entityId\u0022:27,\u0022skill\u0022:5,\u0022strain\u0022:0,\u0022known\u0022:[],\u0022queue\u0022:[],\u0022prepared\u0022:[],\u0022capacity\u0022:5},\u002228\u0022:{\u0022entityId\u0022:28,\u0022skill\u0022:5,\u0022strain\u0022:0,\u0022known\u0022:[],\u0022queue\u0022:[],\u0022prepared\u0022:[],\u0022capacity\u0022:5},\u002229\u0022:{\u0022entityId\u0022:29,\u0022skill\u0022:5,\u0022strain\u0022:0,\u0022known\u0022:[],\u0022queue\u0022:[],\u0022prepared\u0022:[],\u0022capacity\u0022:5}},\u0022casts\u0022:{},\u0022effects\u0022:[],\u0022ruin\u0022:{\u0022tabletId\u0022:45,\u0022folioId\u0022:46,\u0022cacheId\u0022:47,\u0022doorId\u0022:0,\u0022engineId\u0022:32,\u0022guardianId\u0022:124,\u0022discovered\u0022:true,\u0022archiveRead\u0022:true,\u0022cacheSurveyed\u0022:true,\u0022lensRecovered\u0022:true,\u0022lensId\u0022:98,\u0022engineKnowledge\u0022:\u0022Understood\u0022,\u0022engineRestored\u0022:true,\u0022defenseComplete\u0022:true,\u0022wardWarning\u0022:false,\u0022wardAt\u0022:60480,\u0022gardenCell\u0022:41020},\u0022tutorial\u0022:{\u0022enabled\u0022:true,\u0022completed\u0022:[\u0022discovery\u0022,\u0022food\u0022,\u0022crossing\u0022,\u0022archive\u0022,\u0022lens\u0022,\u0022preparation\u0022,\u0022restoration\u0022,\u0022defense\u0022,\u0022adaptation\u0022,\u0022magic\u0022],\u0022dismissed\u0022:false,\u0022startedAt\u0022:0,\u0022completedAt\u0022:124140},\u0022notices\u0022:[{\u0022id\u0022:1,\u0022tick\u0022:1470,\u0022kind\u0022:\u0022Discovery\u0022,\u0022text\u0022:\u0022The field tablet identifies a buried observatory and opens its entry stair. The Borrowed Dawn formula is recovered.\u0022,\u0022cell\u0022:7369},{\u0022id\u0022:2,\u0022tick\u0022:1500,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Survey the observatory.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:3,\u0022tick\u0022:13350,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Keep a food reserve.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:4,\u0022tick\u0022:14370,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Bridge the archive rift.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:5,\u0022tick\u0022:15420,\u0022kind\u0022:\u0022Discovery\u0022,\u0022text\u0022:\u0022The keeper\\u0027s folio explains four formulae, the hatch sequence and the engine\\u0027s cracked lens. The deep stair opens.\u0022,\u0022cell\u0022:23996},{\u0022id\u0022:6,\u0022tick\u0022:15450,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Read the keeper\\u0027s folio.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:7,\u0022tick\u0022:16500,\u0022kind\u0022:\u0022Discovery\u0022,\u0022text\u0022:\u0022A unique memory-glass lens and six sun-salt reagents are recovered from the seed reliquary.\u0022,\u0022cell\u0022:40123},{\u0022id\u0022:8,\u0022tick\u0022:16530,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Recover the unique lens.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:9,\u0022tick\u0022:18000,\u0022kind\u0022:\u0022Discovery\u0022,\u0022text\u0022:\u0022The hatch opens safely. The machine hall\\u0027s stores are accessible.\u0022,\u0022cell\u0022:24649},{\u0022id\u0022:10,\u0022tick\u0022:19530,\u0022kind\u0022:\u0022Discovery\u0022,\u0022text\u0022:\u0022The archive\\u0027s diagram reveals the engine\\u0027s cracked lens and unstable light coupling.\u0022,\u0022cell\u0022:40386},{\u0022id\u0022:12,\u0022tick\u0022:33750,\u0022kind\u0022:\u0022Prepared\u0022,\u0022text\u0022:\u0022Ilyra prepared Ember of the Borrowed Dawn.\u0022,\u0022cell\u0022:8249},{\u0022id\u0022:13,\u0022tick\u0022:33780,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Prepare a formula.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:15,\u0022tick\u0022:35940,\u0022kind\u0022:\u0022Prepared\u0022,\u0022text\u0022:\u0022Ilyra prepared The Patient Door.\u0022,\u0022cell\u0022:8378},{\u0022id\u0022:17,\u0022tick\u0022:39510,\u0022kind\u0022:\u0022Prepared\u0022,\u0022text\u0022:\u0022Ilyra prepared Arithmetic of Returning Flesh.\u0022,\u0022cell\u0022:8378},{\u0022id\u0022:19,\u0022tick\u0022:52500,\u0022kind\u0022:\u0022Prepared\u0022,\u0022text\u0022:\u0022Ilyra prepared The Invisible Porter.\u0022,\u0022cell\u0022:8249},{\u0022id\u0022:20,\u0022tick\u0022:52500,\u0022kind\u0022:\u0022Interrupted\u0022,\u0022text\u0022:\u0022A formula channel was interrupted; its preparation is spent.\u0022,\u0022cell\u0022:8249},{\u0022id\u0022:21,\u0022tick\u0022:59580,\u0022kind\u0022:\u0022Restoration\u0022,\u0022text\u0022:\u0022The daylight engine wakes. The deep garden now has usable light and warmth; an ancient warder will awaken in one game hour.\u0022,\u0022cell\u0022:40386},{\u0022id\u0022:22,\u0022tick\u0022:60480,\u0022kind\u0022:\u0022Threat\u0022,\u0022text\u0022:\u0022The observatory warder awakens to defend its engine.\u0022,\u0022cell\u0022:40514},{\u0022id\u0022:23,\u0022tick\u0022:62160,\u0022kind\u0022:\u0022Defense\u0022,\u0022text\u0022:\u0022The warder is disabled. The refuge keeps the engine and its recovered knowledge.\u0022,\u0022cell\u0022:40386},{\u0022id\u0022:24,\u0022tick\u0022:62160,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Defend the restored observatory.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:26,\u0022tick\u0022:124050,\u0022kind\u0022:\u0022Prepared\u0022,\u0022text\u0022:\u0022Ilyra prepared Ember of the Borrowed Dawn.\u0022,\u0022cell\u0022:8249},{\u0022id\u0022:28,\u0022tick\u0022:124140,\u0022kind\u0022:\u0022Cast\u0022,\u0022text\u0022:\u0022Ilyra cast Ember of the Borrowed Dawn.\u0022,\u0022cell\u0022:8249},{\u0022id\u0022:29,\u0022tick\u0022:124140,\u0022kind\u0022:\u0022Objective\u0022,\u0022text\u0022:\u0022Completed: Use a prepared formula.\u0022,\u0022cell\u0022:41020},{\u0022id\u0022:30,\u0022tick\u0022:124140,\u0022kind\u0022:\u0022Milestone\u0022,\u0022text\u0022:\u0022The observatory vertical slice is complete. Continue growing, building and caring for the refuge.\u0022,\u0022cell\u0022:41020}],\u0022hostiles\u0022:[329],\u0022collapses\u0022:0,\u0022completedCasts\u0022:1,\u0022failedCasts\u0022:0,\u0022porterDeliveries\u0022:0,\u0022musicEnabled\u0022:true,\u0022soundEnabled\u0022:true}},\u0022view\u0022:{\u0022cameraX\u0022:64,\u0022cameraY\u0022:64,\u0022zoom\u0022:1,\u0022selectedEntityId\u0022:0,\u0022solarWorldPane\u0022:true,\u0022solarPage\u0022:\u0022Projects\u0022,\u0022solarProject\u0022:\u0022Vessel\u0022,\u0022solarFaction\u0022:0,\u0022regionalSiteId\u0022:0,\u0022regionalPartyId\u0022:0,\u0022regionalFactionId\u0022:0,\u0022regionalQuestId\u0022:0,\u0022level\u0022:0,\u0022selectedEntityIds\u0022:[],\u0022openTab\u0022:\u0022World\u0022,\u0022showGrid\u0022:false,\u0022showZones\u0022:true}}","sha256":"7BFC03DE73B2157EE73AA1F589234B9E1A031C5E797A2B50A1AC780DDF3DE385"}